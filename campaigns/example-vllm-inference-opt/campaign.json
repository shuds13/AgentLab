{
  "_comment": "What this campaign runs. `resources` overrides the system's defaults; `target` is handed to the job, merging over the system's.",
  "system": "aurora",
  "agent": {
    "provider": "claude"
  },
  "resources": {
    "queue": "debug",
    "walltime": "01:00:00",
    "num_nodes": 1
  },
  "target": {
    "model": "meta-llama/Meta-Llama-3-70B",
    "timeout": 5400,
    "env": {
      "CCL_PROCESS_LAUNCHER": "hydra",
      "HF_HOME": "/flare/datasets/model-weights",
      "HF_DATASETS_CACHE": "/flare/datasets/model-weights",
      "HF_MODULES_CACHE": "/flare/datasets/model-weights",
      "RAY_TMPDIR": "/tmp"
    }
  }
}
