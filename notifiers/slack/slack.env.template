# How this lab talks to Slack. Copy this file and fill it in:
#
#     cp notifiers/slack/slack.env.template notifiers/slack/slack.env
#
# The copy is not tracked by git. Which channels are used, and what runs at all, is
# lab.yaml; this file is the credentials and the reader's behaviour. Every setting is
# an environment variable, and a value already in the environment wins over the one
# here. Full list with defaults: docs/settings.md.

# The bot user as people mention it in the channel. Used when a mention is typed
# without Slack autocomplete.
SLACK_BOT_NAME="${SLACK_BOT_NAME:-@cas_agent}"

# Credentials, kept outside the repository. Both are empty until you name a file, and
# a lab that names none has no Slack: it writes its transcript and nothing leaves the
# machine. The channel comes with the webhook URL, so two labs pointed at one file are
# one conversation -- give each lab its own file to keep them apart.
SLACK_WEBHOOK_FILE="${SLACK_WEBHOOK_FILE:-}"
SLACK_BOT_TOKEN_FILE="${SLACK_BOT_TOKEN_FILE:-}"

# Seconds between channel checks. conversations.history is Slack Tier 3 (50+ req/min),
# so 5s is well inside the limit and is what end-to-end latency mostly depends on.
SLACK_FETCH_POLL="${SLACK_FETCH_POLL:-5}"

# Forward every channel message to the secretary, so people do not have to @-mention
# it, and let it judge which are for it. Mentions only, when the secretary is down.
SLACK_READ_ALL="${SLACK_READ_ALL:-false}"

# Which transport carries a message off the machine: notifiers/<name>/notify.sh.
# Somewhere other than Slack is another directory beside this one, named here.
NOTIFIER="${NOTIFIER:-slack}"
