# Campaign output. run.sh writes everything an agent produces here.
workspace/*
!workspace/*/
workspace/*/*
!workspace/*/README.md

# Your access details: endpoint UUIDs, accounts, paths.
users/*
!users/user1/

__pycache__/
*.pyc
*.orig
.venv/
venv/

# Local scratch: proxy configs, venvs, probes.
scratch/

# Lab messaging settings: channel IDs, credential paths. The transports themselves
# are part of the framework and are tracked; only a lab's filled-in copy is not.
notifiers/**/*.env

# This lab's own settings: what it runs, its models, its channels.
lab.yaml
litellm/config.yaml
