# Globus Compute endpoint template -- Slurm.
#
# Lives on the machine that runs the work, at
#   ~/.globus_compute/<endpoint-name>/user_config_template.yaml.j2
# Placeholders are filled from the bucket's settings (README: "How the pieces fit together").
#
# EDIT: account, partition, worker_init.
# Slurm calls it "partition" where PBS calls it "queue"; this accepts either.

# Stop the user endpoint after ~10 idle minutes, ending its blocks (README: "Idle timeout").
idle_heartbeats_soft: 20

engine:
  type: GlobusComputeEngine
  job_status_kwargs: {max_idletime: 600}   # hold an idle block for 10 min
  max_workers_per_node: {{ max_workers_per_node | default(1) }}

  provider:
    type: SlurmProvider
    launcher:
      type: SimpleLauncher

    account: {{ account }}
    partition: {{ partition | default(queue) }}
    walltime: {{ walltime | default("00:30:00") }}

    nodes_per_block: {{ nodes_per_block | default(1) }}
    # 1 as on facility endpoints; set to nodes_per_block for a block per task
    # (README: parallelism).
    parallelism: {{ parallelism | default(1) }}
    init_blocks: 0
    min_blocks: 0
    max_blocks: {{ max_blocks | default(1) }}

    # EDIT: activate the environment the job needs. The worker starts in a bare
    # shell, so anything the job assumes must be set up here.
    worker_init: |
      # module load ...
      # source ~/venvs/myenv/bin/activate
