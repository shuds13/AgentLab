# Globus Compute endpoint template -- PBS (tested on ALCF Polaris).
#
# Lives on the machine that runs the work, at
#   ~/.globus_compute/<endpoint-name>/user_config_template.yaml.j2
# Placeholders are filled from the bucket's settings (README: "How the pieces fit together").
#
# EDIT: account, filesystems, and worker_init are site- and project-specific.

# Stop the user endpoint after ~10 idle minutes, ending its blocks (README: "Idle timeout").
idle_heartbeats_soft: 20

engine:
  type: GlobusComputeEngine
  job_status_kwargs: {max_idletime: 600}   # hold an idle block for 10 min
  max_workers_per_node: {{ max_workers_per_node | default(1) }}   # default 1: one task per node

  provider:
    type: PBSProProvider
    launcher:
      type: SimpleLauncher         # the task's own mpiexec spans the allocation

    account: {{ account }}
    queue: {{ queue }}
    cpus_per_node: 64
    # ALCF requires the filesystems you touch to be declared.
    scheduler_options: "#PBS -l filesystems=home:eagle"
    # EDIT: activate the environment your job needs. Keep it to one line.
    worker_init: "module use /soft/modulefiles && module load conda && conda activate && source ~/venvs/gcompute/bin/activate && export TMPDIR=/tmp && export FI_PROVIDER=cxi && export MPICH_OFI_NIC_POLICY=NUMA"
    walltime: {{ walltime|default("00:30:00") }}

    # default() is a fallback, not a ceiling; hard-code or clamp to enforce a limit.
    nodes_per_block: {{ nodes_per_block | default(1) }}
    # 1 as on facility endpoints; set to nodes_per_block for a block per task
    # (README: parallelism).
    parallelism: {{ parallelism | default(1) }}
    init_blocks: {{ init_blocks|default(0) }}
    min_blocks: {{ min_blocks|default(0) }}
    max_blocks: {{ max_blocks|default(1) }}
