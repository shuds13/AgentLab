{
  "_comment": "Facts about Aurora that are the same for everyone. Credentials and allocations go in users/<you>/aurora.json; what to run goes in the campaign.",

  "ppn": 1,
  "max_concurrent": 1,

  "target": {
    "worker_setup": "module load frameworks",
    "env": {
      "http_proxy": "http://proxy.alcf.anl.gov:3128",
      "https_proxy": "http://proxy.alcf.anl.gov:3128",
      "no_proxy": "localhost,127.0.0.1,.alcf.anl.gov",
      "CCL_PROCESS_LAUNCHER": "hydra",
      "HF_HOME": "/flare/datasets/model-weights",
      "HF_DATASETS_CACHE": "/flare/datasets/model-weights",
      "HF_MODULES_CACHE": "/flare/datasets/model-weights",
      "RAY_TMPDIR": "/tmp",
      "TMPDIR": "/tmp"
    }
  },

  "bucket_defaults": {
    "queue": "debug",
    "num_nodes": 1,
    "walltime": "01:00:00",
    "init_blocks": 0,
    "min_blocks": 0,
    "max_blocks": 1,
    "max_retries_on_system_failure": 0
  }
}
