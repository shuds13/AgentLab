{
  "_comment": "Aurora. Starting points only \u2014 a campaign overrides anything here that depends on what it runs, in campaign.json. Credentials go in users/<you>/aurora.json.",
  "ppn": 1,
  "max_concurrent": 1,
  "target": {
    "worker_setup": "module load frameworks",
    "env": {
      "http_proxy": "http://proxy.alcf.anl.gov:3128",
      "https_proxy": "http://proxy.alcf.anl.gov:3128",
      "no_proxy": "localhost,127.0.0.1,.alcf.anl.gov",
      "TMPDIR": "/tmp"
    }
  },
  "bucket_defaults": {
    "queue": "debug",
    "num_nodes": 1,
    "walltime": "01:00:00",
    "init_blocks": 0,
    "min_blocks": 0,
    "max_blocks": 1,
    "max_retries_on_system_failure": 0
  }
}
